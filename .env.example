NEXT_PUBLIC_SITE_URL=https://forsecure.id

# Contact form SMTP. Port 465 uses SMTP_SECURE=true; port 587 uses false.
SMTP_HOST=mail.forsecure.id
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@forsecure.id
SMTP_PASSWORD=replace-with-cpanel-mailbox-password
CONTACT_FROM=Forsecure Website <hello@forsecure.id>
CONTACT_TO=hello@forsecure.id
